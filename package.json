{
  "name": "firekylin-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @firekylin/admin dev",
    "build": "pnpm --filter @firekylin/admin build",
    "watch": "pnpm --filter @firekylin/admin watch",
    "preview": "pnpm --filter @firekylin/admin preview",
    "build:package": "pnpm --filter firekylin build:package",
    "build:release": "pnpm --filter firekylin build:release",
    "start": "pnpm --filter firekylin start",
    "test": "pnpm --filter firekylin test",
    "lint": "pnpm --filter firekylin lint"
  }
}
