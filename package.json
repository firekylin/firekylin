{
  "name": "firekylin",
  "bin": {
    "firekylin": "bin/firekylin.js"
  },
  "main": "index.js",
  "description": "A Simple & Fast Node Bloging Platform Base On ThinkJS 3.x & ReactJS & ES2015+",
  "version": "2.8.0",
  "types": "types/index.d.ts",
  "author": "lizheming <i@imnerd.org>",
  "scripts": {
    "start": "node development.js",
    "copy-package": "node bin/copy_package.js",
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test:widget": "node --test test/widget/*.test.js",
    "test:auth": "node --test test/service/admin-auth.test.js test/service/hugo-import.test.js test/plugin/jwt-route.test.js",
    "test:plugin": "node --test test/plugin/*.test.js",
    "test:cli": "node --test test/cli/*.test.js",
    "test:types": "tsc -p test/types/tsconfig.json --noEmit",
    "lint": "eslint ./src ./*.js ./www/theme/firekylin --cache || true",
    "lint-fix": "eslint ./src ./*.js ./www/theme/firekylin --fix || true",
    "lint-break-on-errors": "echo '\n[INFO] Running ESLint...\n[INFO] (Autofix with `npm run lint-fix`)' && eslint ./src ./*.js ./www/theme/firekylin",
    "check-extraneous-pkgs": "pnpm list --depth=0 && echo '[SUCCESS] No extraneous packages.' || (echo '[INFO] Pruning extraneous packages...\n' && pnpm prune)",
    "cron:rss": "npm start -- \"admin/cron/rss\"",
    "build:pkg": "pkg pkg.js --out-path=dist/"
  },
  "pre-commit": [
    "lint-break-on-errors"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@uiw/codemirror-theme-monokai": "^4.25.12",
    "@vercel/blob": "^2.8.1",
    "codemirror-lang-eta": "^1.0.2",
    "dayjs": "^1.11.23",
    "feedparser": "^2.6.0",
    "files-sdk": "^3.1.0",
    "fs-extra": "^11.4.1",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.2",
    "ldapts": "^9.2.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "mathjax": "^4.1.3",
    "nodemailer": "^10.1.0",
    "on-finished": "^2.4.1",
    "phpass": "^1.0.0",
    "qiniu": "^7.15.2",
    "semver": "^7.8.5",
    "speakeasy": "^2.0.0",
    "think-cache": "^1.1.2",
    "think-cache-file": "^1.1.2",
    "think-logger3": "^1.4.0",
    "think-model": "^1.5.4",
    "think-model-mysql2": "^2.0.0",
    "think-model-postgresql": "^1.1.10",
    "think-model-sqlite": "^2.0.1",
    "think-router-rest": "^1.0.5",
    "think-view": "^1.0.13",
    "think-view-eta": "^1.0.0",
    "thinkjs": "^4.0.0",
    "turndown": "^7.2.4",
    "upyun": "^3.4.6",
    "wxr": "^0.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "history": "^5.3.0",
    "immutability-helper": "^3.1.1",
    "less": "^4.9.1",
    "md5": "^2.3.0",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "pre-commit": "^2.0.0",
    "qrcode.react": "4.2.0",
    "rc-picker": "^4.11.3",
    "react": "^19.3.0",
    "react-color": "^2.19.3",
    "react-datetime": "^3.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rxjs": "^7.8.2",
    "superagent": "^10.4.1",
    "think-watcher": "^3.0.4",
    "tiny-pinyin": "^1.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": "https://github.com/lizheming/firekylin",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "better-sqlite3": "12.4.1"
    }
  },
  "readmeFilename": "README.md",
  "thinkjs": {
    "metadata": {
      "name": "firekylin",
      "description": "A Simple & Fast Node Bloging Platform Base On ThinkJS 4.x & ReactJS & ES2015+",
      "author": "lizheming <i@imnerd.org>",
      "babel": false
    },
    "projectName": "firekylin",
    "templateName": "/usr/local/lib/node_modules/think-cli/default_template",
    "cacheTemplatePath": "/Users/lizheming/.think-templates/-usr-local-lib-node_modules-think-cli-default_template",
    "clone": false,
    "isMultiModule": false
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "view/**/*",
      "www/**/*"
    ],
    "targets": [
      "node10-linux-x64",
      "node10-macos-x64",
      "node10-win-x64"
    ]
  }
}
