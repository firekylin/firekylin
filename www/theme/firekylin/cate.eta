<% layout('./layout') %>
<% block('title', () => { %>分类 - <%= firekylin.options.title %><% }) %>
<% block('headers', () => { %><link rel="canonical" href="<%= firekylin.site_url %>/categories" /><% }) %>
<% block('content', () => { %>
<article class="post categories">
  <h1 class="title">分类</h1>
  <div class="entry-content"><section>
    <% firekylin.categories.forEach(cate => { %>
    <a href="/cate/<%= cate.pathname %>" data-cate="<%= cate.name %>"><%= cate.name %>(<%= cate.count %>)</a>
      <% if (cate.children) { cate.children.forEach(child => { %><a href="/cate/<%= child.pathname %>" data-cate="<%= child.name %>" class="child"><%= child.name %>(<%= child.count %>)</a><% }) } %>
    <% }) %>
  </section></div>
</article>
<% }) %>
