<%
function pageUrl(page) {
  const url = new URL(firekylin.ctx.url, 'http://firekylin.local');
  url.searchParams.set('page', page);
  return url.pathname + url.search;
}
%>
<nav class="pagination">
  <% if (firekylin.pagination.currentPage > 1) { %><a href="<%= pageUrl(firekylin.pagination.currentPage - 1) %>" class="prev">&laquo; <%= firekylin.t("上一页") %></a><% } %>
  <% if (firekylin.pagination.currentPage < firekylin.pagination.totalPages) { %><a href="<%= pageUrl(firekylin.pagination.currentPage + 1) %>" class="next"><%= firekylin.t("下一页") %> &raquo;</a><% } %>
  <div class="center"><a href="/archives"><%= firekylin.t("博客归档") %></a></div>
</nav>
