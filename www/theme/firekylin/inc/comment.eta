<div id="comments" data-type="<%= firekylin.options.comment.type %>" data-thread-key="<%= firekylin.think.md5(firekylin.ctx.get('pathname')) %>" data-url="<%= firekylin.site_url + firekylin.ctx.url %>">
  <h1 class="title">Comments</h1>
  <% if (firekylin.options.comment.name) { %>
    <% const identifier = firekylin.think.md5(firekylin.ctx.param('pathname')); %>
    <% if (firekylin.options.comment.type === 'disqus') { %>
    <div id="disqus_thread" data-url="<%= firekylin.site_url + firekylin.ctx.url %>" data-identifier="<%= identifier %>" data-name="<%= firekylin.options.comment.name %>">评论加载中...<br><br>注：如果长时间无法加载，请针对 disq.us | disquscdn.com | disqus.com 启用代理。</div>
    <% } else if (firekylin.options.comment.type === 'hypercomments') { %><div id="hypercomments_widget" data-url="<%= firekylin.site_url + firekylin.ctx.url %>" data-identifier="<%= identifier %>" data-name="<%= firekylin.options.comment.name %>"></div>
    <% } else if (firekylin.options.comment.type === 'changyan') { %><div id="SOHUCS" sid="<%= identifier %>" data-name="<%= firekylin.options.comment.name %>"></div>
    <% } else if (firekylin.options.comment.type === 'gitalk') { %><div id="gitalk-container" data-identifier="<%= identifier %>" data-name="<%= firekylin.options.comment.name %>"></div>
    <% } else if (firekylin.options.comment.type === 'waline') { %><div id="waline-container" data-name="<%= firekylin.options.comment.name %>"></div>
    <% } else if (firekylin.options.comment.type === 'valine') { %><div id="valine-container" data-name="<%= firekylin.options.comment.name %>"></div>
    <% } else { %><%~ firekylin.options.comment.name %><% } %>
  <% } else { %><p>请在后台配置评论类型和相关的值。</p><% } %>
</div>
