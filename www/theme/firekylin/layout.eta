<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no">
  <title><%~ block('title') %></title>
  <link rel="icon" href="<%= firekylin.options.favicon_url || '/static/img/firekylin.jpg' %>">
  <% if (firekylin.options.favicon) { %><link rel="shortcut icon" href="<%= firekylin.options.favicon %>" type="image/x-icon"><% } %>
  <link rel="alternate" type="application/rss+xml" title="RSS 2.0" href="/rss.html">
  <link rel="search" type="application/opensearchdescription+xml" href="/opensearch.xml" title="<%= firekylin.options.title %>">
  <% if (firekylin.options.keywords) { %><meta name="keywords" content="<%= firekylin.options.keywords %>"><% } %>
  <% if (firekylin.options.description) { %><meta name="description" content="<%= firekylin.options.description %>"><% } %>
  <%~ block('headers') %>
  <link rel="stylesheet" href="/theme/<%= firekylin.options.theme %>/res/css/all.css" type="text/css" data-ls="css_firekylin">
  <% if (firekylin.themeConfig.sidebarBackground || firekylin.themeConfig.sidebarBackgroundColor || firekylin.themeConfig.customCSS || firekylin.themeConfig.sidebarColor) { %>
  <style>
    <% if (firekylin.themeConfig.sidebarBackground || firekylin.themeConfig.sidebarBackgroundColor) { %>
    #sidebar {
      <% if (firekylin.themeConfig.sidebarBackground) { %>background-image: url('<%= firekylin.themeConfig.sidebarBackground %>');
      background-size: cover;<% } %>
      <% if (firekylin.themeConfig.sidebarBackgroundColor) { %>background-color: <%= firekylin.themeConfig.sidebarBackgroundColor %>;<% } %>
    }
    <% } %>
    <% if (firekylin.themeConfig.sidebarColor) { %>
    #sidebar .profile span,
    #sidebar .buttons li a,
    #sidebar .buttons li a:hover { color: <%= firekylin.themeConfig.sidebarColor %>; }
    <% } %>
    <% if (firekylin.themeConfig.customCSS) { %><%~ firekylin.themeConfig.customCSS %><% } %>
  </style>
  <% } %>
</head>
<body>
  <nav id="sidebar" class="behavior_1">
    <div class="wrap">
      <div class="profile">
        <a href="/"><img src="<%= firekylin.options.logo_url || '/static/img/firekylin.jpg' %>" alt="<%= firekylin.options.title %>"></a>
        <span><%= firekylin.options.title %></span>
      </div>
      <ul class="buttons">
        <% firekylin.navigation.forEach(nav => { %>
        <li><a class="" href="<%= nav.url %>" title="<%= nav.label %>">
          <svg class="icon"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-<%= nav.option %>"></use></svg>
          <span><%= nav.label %></span>
        </a></li>
        <% }) %>
      </ul>
      <ul class="buttons"><li>
        <% if (firekylin.options.github_url) { %><a class="inline" rel="nofollow" target="_blank" href="<%= firekylin.options.github_url %>"><svg class="icon" title="GitHub"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-github-v"></use></svg></a><% } %>
        <% if (firekylin.options.twitter_url && firekylin.options.twitter_url.includes('twitter.com')) { %><a class="inline" rel="nofollow" target="_blank" href="<%= firekylin.options.twitter_url %>"><svg class="icon" title="Twitter"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-twitter-v"></use></svg></a><% } %>
        <% if (firekylin.options.twitter_url && firekylin.options.twitter_url.includes('weibo.com')) { %><a class="inline" rel="nofollow" target="_blank" href="<%= firekylin.options.twitter_url %>"><svg class="icon" title="weibo"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-weibo"></use></svg></a><% } %>
        <a class="inline" href="/rss.html"><svg class="icon" title="RSS"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-rss-v"></use></svg></a>
        <a class="inline" href="/search.html"><svg class="icon" title="Search"><use href="/theme/<%= firekylin.options.theme %>/res/icon/icons.svg#icon-search"></use></svg></a>
      </li></ul>
    </div>
  </nav>
  <div id="header">
    <div class="btn-bar"><i></i></div>
    <h1><a href="/"><%= firekylin.options.title %></a></h1>
    <a class="me" href="/about/"><img src="<%= firekylin.options.logo_url || '/static/img/firekylin.jpg' %>" alt="<%= firekylin.options.title %>"></a>
  </div>
  <div id="sidebar-mask"></div>
  <div id="main">
    <%~ block('content') %>
    <footer id="footer" class="inner">
      &copy; <%= firekylin.currentYear %>&nbsp;-&nbsp; <%= firekylin.options.title %>
      <% if (firekylin.options.miitbeian || firekylin.options.mpsbeian) { %>
        <% if (firekylin.options.miitbeian) { %>&nbsp;-&nbsp;<a target="_blank" rel="nofollow" class="external beian" href="http://beian.miit.gov.cn"><%= firekylin.options.miitbeian %></a><% } %>
        <% if (firekylin.options.mpsbeian) { %>&nbsp;-&nbsp;<a target="_blank" rel="nofollow" class="external beian" href="http://www.beian.gov.cn/"><%= firekylin.options.mpsbeian %></a><% } %>
      <% } else { %>&nbsp;-&nbsp;<a href="/"><%= firekylin.ctx.hostname %></a><% } %>
      <br>
      Powered by&nbsp;<a target="_blank" href="https://thinkjs.org">ThinkJS</a>&nbsp;&amp;&nbsp;<a target="_blank" rel="nofollow" class="external" href="https://firekylin.lithub.cc">FireKylin <%= firekylin.VERSION %></a>
    </footer>
  </div>
  <script src="/theme/<%= firekylin.options.theme %>/res/js/firekylin.js" data-ls="js_firekylin"></script>
  <% if (firekylin.options.analyze_code) { %><%~ firekylin.options.analyze_code %><% } %>
  <% if (firekylin.themeConfig.customJS) { %><script><%~ firekylin.themeConfig.customJS %></script><% } %>
</body>
</html>
