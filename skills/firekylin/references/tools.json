            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "pid": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "pathname"
        ]
      },
      "requiredPermissions": [
        "taxonomy:write"
      ],
      "requiresApproval": false
    },
    {
